"""Safe code execution environment for Codyssey."""

import io
import sys
import re
import traceback
from typing import Dict, Any


class Sandbox:
    BLOCKED_MODULES = {
        'os', 'sys', 'subprocess', 'socket', 
        'requests', 'urllib', 'ftplib', 'smtplib'
    }
    
    def __init__(self, timeout: float = 2.0):
        self.timeout = timeout
        self.output_buffer = io.StringIO()
        
    def run_python(self, code: str, restricted: bool = True) -> Dict[str, Any]:
        old_stdout = sys.stdout
        sys.stdout = self.output_buffer
        result = {"success": False, "output": "", "error": None}
        
        try:
            if restricted:
                for mod in self.BLOCKED_MODULES:
                    pattern = rf'^\s*import\s+{mod}\b|^\s*from\s+{mod}\b'
                    if re.search(pattern, code, re.MULTILINE):
                        raise PermissionError(f"Module '{mod}' is blocked.")
            
            safe_builtins = {
                name: __builtins__[name]
                for name in ['print', 'range', 'len', 'str', 'int', 'float',
                             'list', 'dict', 'set', 'tuple', 'abs', 'sum',
                             'min', 'max', 'sorted', 'enumerate', 'zip', 'map',
                             'filter', 'round', 'pow', 'divmod', 'chr', 'ord',
                             'type', 'isinstance', 'hasattr', 'getattr']
            }
            
            exec(code, {"__builtins__": safe_builtins})
            result["success"] = True
            
        except Exception as e:
            result["error"] = f"{type(e).__name__}: {str(e)}"
            
        finally:
            sys.stdout = old_stdout
            result["output"] = self.output_buffer.getvalue()
            self.output_buffer = io.StringIO()
            
        return result
    
    def run_javascript_stub(self, code: str) -> Dict[str, Any]:
        return {
            "success": True,
            "output": f"[JS Sandbox Stub] Would run: {code[:50]}...",
            "error": None
        }
